{
  "version": "v3_single_scale_session",
  "name": "单量表对话式心理状态评估",
  "description": "每次评估会话只绑定一张心理量表。系统将量表题项转化为自然对话问题，只有全部必填题项获得有效回答后，结果才进入正式评分和用户画像更新。",
  "rules": {
    "singleScaleOnly": true,
    "requireCompleteScale": true,
    "incompleteResultPolicy": "invalid_for_scoring",
    "normalChatPolicy": "普通聊天只用于动态画像沉淀，不进入正式量表评分。",
    "crisisPolicy": "如出现明确自伤、自杀意图、计划或行为，优先进入安全风险与人工介入流程。"
  },
  "scales": [
    {
      "id": "PHQ9",
      "name": "PHQ-9",
      "label": "抑郁相关症状筛查",
      "description": "用于评估近两周内低落、兴趣下降、睡眠、精力、注意力、自我评价、动作变化和安全风险等情况。本系统仅用于对话式筛查和管理员复核，不作为医学诊断。",
      "timeWindow": "最近两周",
      "scoreRange": "0-27",
      "completionRequired": 9,
      "severity": [
        {
          "level": "low",
          "min": 0,
          "max": 4,
          "label": "低风险或轻微波动"
        },
        {
          "level": "medium",
          "min": 5,
          "max": 14,
          "label": "需要关注的中等风险"
        },
        {
          "level": "high",
          "min": 15,
          "max": 27,
          "label": "高风险关注"
        }
      ],
      "items": [
        {
          "code": "phq9_01_anhedonia",
          "dimension": "mood",
          "construct": "兴趣或愉快感下降",
          "prompt": "最近两周，原本能让你放松或者有点兴趣的事情，你还愿意去做吗？这种情况大概出现得多频繁？",
          "keywords": [
            "没兴趣",
            "没意思",
            "不想做",
            "提不起劲",
            "什么都不想",
            "空"
          ],
          "max_score": 3
        },
        {
          "code": "phq9_02_low_mood",
          "dimension": "mood",
          "construct": "情绪低落或无望感",
          "prompt": "最近两周，低落、难受或者没有希望的感觉出现得多吗？是偶尔，还是大部分时间都在？",
          "keywords": [
            "低落",
            "难受",
            "沮丧",
            "没希望",
            "崩溃",
            "完蛋",
            "撑不住"
